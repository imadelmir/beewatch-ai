// =========================================================================== //
// BeeWatch AI - schema relazionale (M2-T4)  ·  versione 3
// =========================================================================== //
//
// Questo file e' la fonte del diagramma ER. Per rigenerarlo:
//
//   1. apri https://dbdiagram.io/d
//   2. incolla tutto il contenuto di questo file nel pannello di sinistra
//   3. Export -> PNG   ->  salva come docs/diagrams/er_diagram.png
//
// Da dbdiagram si puo' anche esportare il DDL MySQL (Export -> MySQL): sara' il
// punto di partenza di sql/schema.sql in M2-T5. Va comunque riletto a mano:
// dbdiagram non genera i CHECK, le colonne generate e la codifica dei caratteri.
// Tutto cio' che manca e' elencato in fondo a questo file.
//
// Le motivazioni di ogni scelta sono in M2-T4_schema.md.
//
// --------------------------------------------------------------------------- //
// Convenzioni di nomenclatura (valgono senza eccezioni)
// --------------------------------------------------------------------------- //
//   tabelle          plurale, minuscolo, senza accenti    alveari, produzione_usda
//   chiave primaria  id, oppure la chiave naturale        id, codice, versione
//   chiave esterna   <tabella_al_singolare>_id            alveare_id, tipo_miele_id
//   date di sistema  creato_il, aggiornato_il             sempre al maschile
//   booleani         aggettivo affermativo                attivo, regina_vista
//   indici           idx_<tabella>_<colonne>              idx_ispezioni_alveare_data
//   unicita'         uq_<tabella>_<colonne>               uq_alveari_apiario_codice
//
// Tipi: nel DDL tutti gli identificatori e i contatori vanno dichiarati
// UNSIGNED (vedi la lista in fondo). Qui non compaiono perche' dbdiagram non
// accetta tipi composti da piu' parole.
//
// Indici: InnoDB crea automaticamente un indice su ogni colonna di chiave
// esterna. Qui sono dichiarati solo quelli che InnoDB NON crea da solo: i
// compositi e quelli su colonne non vincolate. Un indice composito che inizia
// con la colonna di FK sostituisce quello automatico.
//
// Date: `aggiornato_il` richiede sia DEFAULT sia ON UPDATE. Con il solo
// ON UPDATE, ogni INSERT che non valorizzi la colonna fallirebbe.

Project beewatch_ai {
  database_type: 'MySQL'
  Note: '''
    BeeWatch AI - monitoraggio di apiari amatoriali.
    Quattro livelli: operativo (dati dell'apicoltore), riferimento (valori fissi
    e dataset USDA), modello (versioni, metriche e spiegabilita' del ML),
    tracciabilita' (previsioni prodotte e conversazioni con l'assistente).
  '''
}

// --------------------------------------------------------------------------- //
// Livello operativo
// --------------------------------------------------------------------------- //

Table utenti [headercolor: #E9A825] {
  id            int          [pk, increment]
  email         varchar(255) [unique, not null]
  nome_completo varchar(120) [not null]
  hash_password char(60)     [not null, note: 'bcrypt: 60 caratteri esatti']
  tema          varchar(10)  [not null, default: 'auto', note: 'auto | chiaro | scuro']
  creato_il     datetime     [not null, default: `CURRENT_TIMESTAMP`]
  aggiornato_il datetime     [not null, default: `CURRENT_TIMESTAMP`, note: 'ON UPDATE CURRENT_TIMESTAMP']
  attivo        boolean      [not null, default: true]

  Note: '''
    La password in chiaro non entra mai nel database.
    `attivo = false` disattiva l'accesso ma conserva i dati.
    La cancellazione GDPR e' invece un DELETE fisico: vedi le cascate in fondo.
    `tema` esiste solo perche' il selettore chiaro/scuro dell'interfaccia deve
    ricordare la scelta fra una sessione e l'altra. Ogni altra impostazione vive
    in .env (M1-T3): due fonti di verita' per la configurazione sono un errore.
  '''
}

Table apiari [headercolor: #E9A825] {
  id            int           [pk, increment]
  utente_id     int           [not null]
  nome          varchar(120)  [not null]
  localita      varchar(160)
  latitudine    decimal(9,6)  [note: 'CHECK fra -90 e 90']
  longitudine   decimal(9,6)  [note: 'CHECK fra -180 e 180']
  note          text
  creato_il     datetime      [not null, default: `CURRENT_TIMESTAMP`]
  aggiornato_il datetime      [not null, default: `CURRENT_TIMESTAMP`, note: 'ON UPDATE CURRENT_TIMESTAMP']
  attivo        boolean       [not null, default: true]

  indexes {
    (utente_id, nome)   [unique, name: 'uq_apiari_utente_nome']
    (utente_id, attivo) [name: 'idx_apiari_utente_attivo']
  }
  Note: '''
    Le coordinate sono dati personali indiretti: mai inviate a un LLM esterno.
    `attivo` protegge dalla cancellazione accidentale: eliminare un apiario
    cancella a cascata alveari, ispezioni e raccolti di anni.
    Il nome e' unico per utente: due apiari omonimi renderebbero ambigua ogni
    schermata e ogni riepilogo.
  '''
}

Table alveari [headercolor: #E9A825] {
  id                 int             [pk, increment]
  apiario_id         int             [not null]
  stato_alveare_id   tinyint          [not null]
  codice             varchar(20)     [not null]
  data_installazione date
  anno_regina        smallint          [note: 'CHECK fra 2000 e 2100']
  note               text
  creato_il          datetime        [not null, default: `CURRENT_TIMESTAMP`]
  aggiornato_il      datetime        [not null, default: `CURRENT_TIMESTAMP`, note: 'ON UPDATE CURRENT_TIMESTAMP']
  attivo             boolean         [not null, default: true]

  indexes {
    (apiario_id, codice) [unique, name: 'uq_alveari_apiario_codice']
  }
  Note: 'Il codice e\' unico dentro l\'apiario, non nel database.'
}

Table ispezioni [headercolor: #E9A825] {
  id                 int              [pk, increment]
  alveare_id         int              [not null]
  livello_rischio_id tinyint          [not null]
  data_ispezione     date             [not null]
  peso_kg            decimal(6,2)     [note: 'CHECK >= 0']
  telaini_covata     tinyint          [note: 'CHECK <= 30']
  telaini_scorte     tinyint          [note: 'CHECK <= 30']
  regina_vista       boolean          [not null, default: false]
  sciamatura         boolean          [not null, default: false]
  note               text             [note: 'Testo libero: input dell\'assistente AI (M5)']
  creato_il          datetime         [not null, default: `CURRENT_TIMESTAMP`]
  aggiornato_il      datetime         [not null, default: `CURRENT_TIMESTAMP`, note: 'ON UPDATE CURRENT_TIMESTAMP']

  indexes {
    (alveare_id, data_ispezione) [name: 'idx_ispezioni_alveare_data']
  }
  Note: 'data_ispezione e creato_il sono distinte: si registra la sera cio\' che si e\' fatto la mattina.'
}

Table raccolti [headercolor: #E9A825] {
  id            int              [pk, increment]
  apiario_id    int              [not null]
  alveare_id    int              [note: 'Facoltativo: solo se si smiela tenendo separati i melari']
  tipo_miele_id tinyint          [not null]
  data_raccolto date             [not null]
  quantita_kg   decimal(6,2)     [not null, note: 'CHECK > 0']
  note          text
  creato_il     datetime         [not null, default: `CURRENT_TIMESTAMP`]
  aggiornato_il datetime         [not null, default: `CURRENT_TIMESTAMP`, note: 'ON UPDATE CURRENT_TIMESTAMP']

  indexes {
    (apiario_id, data_raccolto) [name: 'idx_raccolti_apiario_data']
  }
  Note: '''
    Il raccolto appartiene all'apiario; l'alveare e' un dettaglio facoltativo.
    Molti apicoltori amatoriali smielano tutto insieme e pesano il totale: chi
    invece tiene separati i melari puo' indicare anche l'arnia.

    E' anche il modo in cui e' costruito il dataset USDA, dove la resa per
    colonia non e' misurata ma calcolata come produzione totale diviso numero
    di colonie: il nostro dato e quello di riferimento nascono cosi' allo
    stesso modo e restano confrontabili.

    Il database non puo' garantire che l'alveare indicato appartenga a
    quell'apiario: un CHECK non legge altre tabelle. La verifica e'
    applicativa, in M3.
  '''
}

// --------------------------------------------------------------------------- //
// Tabelle di riferimento
// --------------------------------------------------------------------------- //

Table stati_alveare [headercolor: #9AA0AE] {
  id        tinyint          [pk]
  codice    varchar(20)      [unique, not null]
  etichetta varchar(60)      [not null]
  colore    char(7)          [note: 'Esadecimale usato dall\'interfaccia']
  ordine    tinyint          [not null]

  Note: 'in_salute, debole, sciamato, morto, in_osservazione'
}

Table livelli_rischio [headercolor: #9AA0AE] {
  id        tinyint          [pk]
  codice    varchar(20)      [unique, not null]
  etichetta varchar(60)      [not null]
  gravita   tinyint          [not null, note: '1 = nessuno ... 4 = alto']

  Note: 'nessuno, basso, medio, alto'
}

Table tipi_miele [headercolor: #9AA0AE] {
  id        tinyint          [pk]
  codice    varchar(20)      [unique, not null]
  etichetta varchar(60)      [not null]

  Note: 'acacia, millefiori, castagno, tiglio, melata, ...'
}

// --------------------------------------------------------------------------- //
// Riferimento USDA
// --------------------------------------------------------------------------- //

Table stati_usa [headercolor: #5B96FF] {
  codice char(2)     [pk]
  nome   varchar(60) [not null]

  Note: 'I 44 codici presenti nel dataset (M2-T2).'
}

Table produzione_usda [headercolor: #5B96FF] {
  id                    int               [pk, increment]
  codice_stato          char(2)           [not null]
  anno                  smallint          [not null]
  numero_colonie        int               [not null]
  resa_per_colonia_kg   decimal(8,4)      [not null, note: 'Target del modello (M2-T3)']
  produzione_totale_kg  decimal(14,4)     [not null, note: 'DERIVATA: colonie x resa']
  scorte_kg             decimal(14,4)     [not null]
  prezzo_per_kg_usd     decimal(8,4)      [not null]
  valore_produzione_usd decimal(14,2)     [not null, note: 'DERIVATA (arrotondata alla fonte)']

  indexes {
    (codice_stato, anno) [unique, name: 'uq_produzione_usda_stato_anno']
    anno [name: 'idx_produzione_usda_anno']
  }
  Note: '''
    Tabella di sola lettura, ricaricata per intero dall'ETL.
    Le due colonne derivate restano per fedelta' alla fonte ma sono escluse dai
    predittori del modello: e' una denormalizzazione consapevole, motivata in
    M2-T4_schema.md.
  '''
}

// --------------------------------------------------------------------------- //
// Modelli di machine learning
// --------------------------------------------------------------------------- //

Table modelli [headercolor: #3FB463] {
  versione              varchar(40)  [pk, note: 'Es. v1.0.0 — compare accanto a ogni previsione']
  algoritmo             varchar(60)  [not null, note: 'Es. RandomForestRegressor']
  addestrato_il         datetime     [not null]
  righe_addestramento   int          [not null]
  variabili_usate       json         [not null, note: 'Es. ["codice_stato", "anno"]']
  importanza_variabili  json         [note: 'Spiegabilita\': peso di ogni variabile']
  mae_kg                decimal(6,3) [not null, note: 'Criterio DA-05: deve stare sotto il MAE della persistenza']
  rmse_kg               decimal(6,3) [not null]
  r2                    decimal(5,4) [not null]
  percorso_file         varchar(255) [not null, note: 'Il .joblib salvato in models/']
  attivo                boolean      [not null, default: false]
  attivo_unico          tinyint          [note: 'GENERATED: IF(attivo, 1, NULL) — vedi nota']
  note                  text

  indexes {
    attivo_unico [unique, name: 'uq_modelli_uno_attivo']
  }
  Note: '''
    Un solo modello per volta ha attivo = true, ed e' il database a garantirlo:
    la colonna generata `attivo_unico` vale 1 quando attivo e' vero e NULL
    altrimenti. I NULL non partecipano ai vincoli di unicita', quindi possono
    esistere infinite righe inattive e al massimo una attiva. Un secondo
    UPDATE ... SET attivo = TRUE viene rifiutato da MySQL.

    `variabili_usate` e `importanza_variabili` sono la spiegabilita' del
    modello: dicono su quali variabili e' stato addestrato e quanto ognuna pesa.
    Bastano a costruire il grafico "cosa influenza la stima" senza aggiungere
    una tabella.

    Le metriche stanno qui perche' il docente chiede di dichiararle, e perche'
    l'interfaccia deve poter mostrare "modello v1.2, errore medio 3,8 kg"
    accanto alla previsione (M2-T3, sezione "Cosa vedra' l'utente").
  '''
}

// --------------------------------------------------------------------------- //
// Tracciabilita'
// --------------------------------------------------------------------------- //

Table previsioni [headercolor: #8B72C8] {
  id                       int               [pk, increment]
  utente_id                int               [not null]
  alveare_id               int               [note: 'NULL se l\'alveare e\' stato eliminato']
  versione_modello         varchar(40)       [not null]
  codice_stato_riferimento char(2)           [not null]
  anno_riferimento         smallint          [not null]
  stima_kg                 decimal(6,2)      [not null]
  limite_inferiore_kg      decimal(6,2)      [not null]
  limite_superiore_kg      decimal(6,2)      [not null]
  creato_il                datetime          [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (utente_id, creato_il) [name: 'idx_previsioni_utente_data']
  }
  Note: '''
    Gli ingressi del modello sono qui per intero (stato e anno di riferimento):
    la previsione e' quindi riproducibile a distanza di mesi, ricaricando il
    .joblib della versione indicata.
    I due limiti sono obbligatori: M2-T3 stabilisce che una previsione si mostra
    sempre come intervallo. CHECK: inferiore <= stima <= superiore.
    L'anno di riferimento NON e' una FK verso produzione_usda: si puo' chiedere
    una stima per un anno che il dataset non contiene.
  '''
}

Enum ruolo_messaggio {
  utente
  assistente
  sistema
}

Table conversazioni [headercolor: #8B72C8] {
  id            int          [pk, increment]
  utente_id     int          [not null]
  titolo        varchar(160) [not null, default: 'Nuova conversazione']
  creato_il     datetime     [not null, default: `CURRENT_TIMESTAMP`]
  aggiornato_il datetime     [not null, default: `CURRENT_TIMESTAMP`, note: 'Data dell\'ultimo messaggio']

  indexes {
    (utente_id, aggiornato_il) [name: 'idx_conversazioni_utente_aggiornato']
  }
  Note: '''
    Il titolo ha un valore predefinito perche' si genera dal primo messaggio:
    senza default, ogni inserimento dovrebbe passare un segnaposto a mano.
    `aggiornato_il` duplica MAX(messaggi.creato_il): e' una denormalizzazione
    voluta, perche' l'elenco delle conversazioni si ordina per attivita' recente
    e ricalcolarlo a ogni apertura costerebbe una scansione dei messaggi.
    Va aggiornato nella stessa transazione che inserisce il messaggio.
  '''
}

Table messaggi [headercolor: #8B72C8] {
  id               int             [pk, increment]
  conversazione_id int             [not null]
  ruolo            ruolo_messaggio [not null]
  contenuto        text            [not null]
  provider         varchar(20)     [note: 'ollama oppure openrouter']
  modello          varchar(60)
  versione_prompt  varchar(20)     [note: 'Quale prompt di sistema ha prodotto la risposta']
  durata_ms        int             [note: 'Tempo di risposta del provider']
  token_prompt     int         
  token_risposta   int         
  creato_il        datetime        [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (conversazione_id, creato_il) [name: 'idx_messaggi_conversazione_data']
  }
  Note: '''
    provider, modello e versione_prompt stanno sul messaggio, non sulla
    conversazione: l'utente puo' cambiarli a meta' discussione, e chi rilegge
    deve sapere chi ha prodotto quella specifica risposta.
    Le cinque colonne tecniche sono nulle per i messaggi dell'utente.
    Il testo dei prompt NON e' nel database: vive nel repository, dove git ne
    versiona le modifiche. Qui basta il riferimento alla versione.
  '''
}

// --------------------------------------------------------------------------- //
// Relazioni
// --------------------------------------------------------------------------- //
// ON DELETE
//   CASCADE  -> i dati del figlio non hanno senso senza il padre (GDPR art. 17)
//   RESTRICT -> non si cancella un valore ancora in uso
//   SET NULL -> la previsione sopravvive all'alveare: documenta cosa fu detto
//
// ON UPDATE
//   Le chiavi surrogate (id) non cambiano mai: RESTRICT e' corretto e implicito.
//   Le due chiavi naturali - stati_usa.codice e modelli.versione - possono
//   essere corrette: li' serve CASCADE, altrimenti rinominare "v1.0" in
//   "v1.0.0" bloccherebbe tutte le previsioni gia' emesse.

Ref: apiari.utente_id > utenti.id [delete: cascade, update: restrict]
Ref: alveari.apiario_id > apiari.id [delete: cascade, update: restrict]
Ref: ispezioni.alveare_id > alveari.id [delete: cascade, update: restrict]
Ref: raccolti.apiario_id > apiari.id [delete: cascade, update: restrict]
Ref: raccolti.alveare_id > alveari.id [delete: set null, update: restrict]

Ref: alveari.stato_alveare_id > stati_alveare.id [delete: restrict, update: restrict]
Ref: ispezioni.livello_rischio_id > livelli_rischio.id [delete: restrict, update: restrict]
Ref: raccolti.tipo_miele_id > tipi_miele.id [delete: restrict, update: restrict]

Ref: produzione_usda.codice_stato > stati_usa.codice [delete: restrict, update: cascade]

Ref: previsioni.utente_id > utenti.id [delete: cascade, update: restrict]
Ref: previsioni.alveare_id > alveari.id [delete: set null, update: restrict]
Ref: previsioni.codice_stato_riferimento > stati_usa.codice [delete: restrict, update: cascade]
Ref: previsioni.versione_modello > modelli.versione [delete: restrict, update: cascade]

Ref: conversazioni.utente_id > utenti.id [delete: cascade, update: restrict]
Ref: messaggi.conversazione_id > conversazioni.id [delete: cascade, update: restrict]

// --------------------------------------------------------------------------- //
// Raggruppamenti (colorano i riquadri nel diagramma)
// --------------------------------------------------------------------------- //

TableGroup operativo [color: #E9A825] {
  utenti
  apiari
  alveari
  ispezioni
  raccolti
}

TableGroup riferimento [color: #9AA0AE] {
  stati_alveare
  livelli_rischio
  tipi_miele
}

TableGroup usda [color: #5B96FF] {
  stati_usa
  produzione_usda
}

TableGroup modello [color: #3FB463] {
  modelli
}

TableGroup tracciabilita [color: #8B72C8] {
  previsioni
  conversazioni
  messaggi
}

// =========================================================================== //
// Cosa aggiungere a mano in sql/schema.sql (M2-T5)
// =========================================================================== //
// dbdiagram non genera queste tre cose. Vanno scritte nel DDL.
//
// 1. CODIFICA DEI CARATTERI
//    CREATE DATABASE beewatch
//      CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
//    Le note degli apicoltori conterranno accenti ed emoji: `utf8` di MySQL non
//    e' UTF-8 completo, `utf8mb4` si'.
//
// 2. COLONNA GENERATA (tabella modelli)
//    attivo_unico TINYINT UNSIGNED
//      GENERATED ALWAYS AS (IF(attivo, 1, NULL)) VIRTUAL,
//    UNIQUE KEY uq_modelli_uno_attivo (attivo_unico)
//
// 3. UNSIGNED SU IDENTIFICATORI E CONTATORI
//    Tutte le chiavi primarie e le chiavi esterne intere, piu' numero_colonie,
//    telaini_covata, telaini_scorte, anno, anno_regina, anno_riferimento,
//    ordine, gravita, righe_addestramento, durata_ms, token_prompt,
//    token_risposta.  Esempio:  id INT UNSIGNED AUTO_INCREMENT
//    Attenzione: una chiave esterna deve avere ESATTAMENTE lo stesso tipo
//    della colonna a cui punta, UNSIGNED compreso, o MySQL rifiuta il vincolo.
//
// 4. VINCOLI CHECK
//    apiari      CHECK (latitudine  BETWEEN -90  AND 90)
//    apiari      CHECK (longitudine BETWEEN -180 AND 180)
//    alveari     CHECK (anno_regina BETWEEN 2000 AND 2100)
//    ispezioni   CHECK (peso_kg >= 0)
//    ispezioni   CHECK (telaini_covata <= 30)
//    ispezioni   CHECK (telaini_scorte <= 30)
//    raccolti    CHECK (quantita_kg > 0)
//    previsioni  CHECK (limite_inferiore_kg <= stima_kg)
//    previsioni  CHECK (stima_kg <= limite_superiore_kg)
//    previsioni  CHECK (anno_riferimento BETWEEN 1990 AND 2100)
//    utenti      CHECK (tema IN ('auto', 'chiaro', 'scuro'))
//    modelli     CHECK (mae_kg >= 0 AND rmse_kg >= 0)
//
//    I CHECK sono verificati da MySQL solo dalla versione 8.0.16 in poi:
//    prima venivano accettati e ignorati in silenzio. Vale la pena scriverlo
//    nel README accanto al requisito di versione.
