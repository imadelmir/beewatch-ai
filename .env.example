# =========================================================================== #
# BeeWatch AI — configurazione
# =========================================================================== #
#
# Copia questo file in `.env` e compila i valori.
#
#     Windows      copy .env.example .env
#     macOS/Linux  cp .env.example .env
#
# `.env` NON va mai committato: contiene le tue credenziali vere.
# Se per errore ne committi una, rigenerala subito: rimuoverla con un commit
# successivo non serve, resta nella cronologia.
#
# I valori qui sotto sono fittizi ma nel formato giusto.


# --------------------------------------------------------------------------- #
# Database MySQL
# --------------------------------------------------------------------------- #
# È lo storage primario del progetto. MySQL gira in un contenitore Docker
# (docker-compose.yml) che legge queste stesse variabili: al primo avvio crea il
# database e l'utente con questi valori. Non vanno cambiati dopo, o il
# contenitore e l'applicazione parlerebbero di due utenti diversi.
#
# DB_HOST e DB_PORT valgono per chi sta FUORI da Docker: Streamlit lanciato sul
# computer, un client SQL. DB_HOST resta `localhost`; DB_PORT è la porta che MySQL
# pubblica sul computer (solo su 127.0.0.1): cambiala se ne hai già una occupata.
#
# L'applicazione nel contenitore (`docker compose up`) li ignora: docker-compose.yml
# le imposta a `mysql` e 3306, il nome del servizio e la porta interna alla rete di
# Docker, che non cambia mai. Cambiare DB_PORT qui non la tocca.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=beewatch
DB_USER=beewatch
DB_PASSWORD=cambiami_con_una_password_vera

# Password dell'utente root di MySQL. La usa SOLO il contenitore di MySQL per creare
# il database e l'utente qui sopra: docker-compose.yml non la passa all'applicazione,
# che non si connette mai come root. L'utente DB_USER può solo leggere e scrivere i
# dati (SELECT, INSERT, UPDATE, DELETE), non cambiare lo schema: lo fa root, con gli
# script di sql/. Deve comunque essere una password vera, non una parola.
DB_ROOT_PASSWORD=cambiami_con_una_password_di_root


# --------------------------------------------------------------------------- #
# Modello di linguaggio
# --------------------------------------------------------------------------- #
# LLM_PROVIDER accetta due valori:
#
#   ollama      gira in locale, gratis, e le note di ispezione non escono dal
#               tuo computer. È la scelta predefinita e quella che citiamo in
#               docs/etica.md come mitigazione concreta sulla privacy.
#
#   openrouter  gira nel cloud, richiede LLM_API_KEY. Utile per la demo se la
#               macchina non regge il modello in locale.

LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Obbligatoria solo con LLM_PROVIDER=openrouter. Con ollama lasciala vuota.
LLM_API_KEY=

# Secondi di attesa massima per una risposta del modello (5–600).
LLM_TIMEOUT=60


# --------------------------------------------------------------------------- #
# Modello di machine learning
# --------------------------------------------------------------------------- #
# Percorso relativo alla radice del progetto (o assoluto). Se lo lasci vuoto si
# usa il valore qui sotto. Il file nasce in M4-T7: fino ad allora questo valore
# indica solo dove verrà salvato.

MODEL_PATH=models/produzione_v1.joblib


# --------------------------------------------------------------------------- #
# Log
# --------------------------------------------------------------------------- #
# Uno fra: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# In sviluppo DEBUG è comodo; per la demo usa INFO, altrimenti il terminale
# scorre troppo e non si legge niente.

LOG_LEVEL=INFO
